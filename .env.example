# Global environment for docker-compose stack
POSTGRES_DB=bi_analytics
POSTGRES_USER=bi_admin
POSTGRES_PASSWORD=bi_admin_pass
POSTGRES_PORT=5432

# OpenAI settings consumed by backend agent
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# Anthropic settings consumed by backend agent
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Azure OpenAI settings consumed by backend agent
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_ENDPOINT=your_azure_openai_endpoint_here
AZURE_OPENAI_DEPLOYMENT=your_azure_openai_deployment_here
AZURE_OPENAI_API_VERSION=your_azure_openai_api_version_here