# Global environment for docker-compose stack
POSTGRES_DB=bi_analytics
POSTGRES_USER=bi_admin
POSTGRES_PASSWORD=bi_admin_pass
POSTGRES_PORT=5432

# ── LLM Engine ────────────────────────────────────────────────────────────────
# Select the provider. Supported values:
# - langchain-openai
# - langchain-azure-openai
# - langchain-anthropic
LLM_ENGINE=langchain-openai

# ── OpenAI (required when LLM_ENGINE=langchain-openai) ───────────────────────
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# ── Anthropic (required when LLM_ENGINE=langchain-anthropic) ─────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Azure OpenAI (required when LLM_ENGINE=langchain-azure-openai) ───────────
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_ENDPOINT=your_azure_openai_endpoint_here
AZURE_OPENAI_DEPLOYMENT=your_azure_openai_deployment_here
AZURE_OPENAI_API_VERSION=your_azure_openai_api_version_here
